      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Simulasi tanggal hari ini disamakan dengan bulan data dummy (misal: 28 Februari 2026)\nconst today = new Date(2026, 1, 28); // Bulan di JS dimulai dari 0 (1 = Februari)\ntoday.setHours(23, 59, 59, 999);\n\nconst sevenDaysAgo = new Date(2026, 1, 21); // 7 hari ke belakang dari tanggal 28\nsevenDaysAgo.setHours(0, 0, 0, 0);\n\nlet weeklyExpenses = [];\nlet formattedString = \"Data pengeluaran saya minggu ini:\\n\";\nlet hasExpenses = false;\n\nfor (const item of items) {\n  const rawTanggal = item.json.Tanggal; // Contoh: \"01/02/2026\"\n  \n  if (!rawTanggal) continue;\n\n  const parts = String(rawTanggal).split(\"/\");\n  if (parts.length !== 3) continue;\n\n  const day = parseInt(parts[0], 10);\n  const month = parseInt(parts[1], 10) - 1;\n  const year = parseInt(parts[2], 10);\n\n  const expenseDate = new Date(year, month, day, 12, 0, 0);\n\n  if (expenseDate >= sevenDaysAgo && expenseDate <= today) {\n    weeklyExpenses.push(item.json);\n    formattedString += `- ${item.json.Deskripsi}: Rp${item.json[\"Jumlah (IDR)\"]}\\n`;\n    hasExpenses = true;\n  }\n}\n\nreturn [{\n  json: {\n    promptData: formattedString,\n    hasExpenses: hasExpenses\n  }\n}];"
      },
