    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst clean = raw.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(clean);\n} catch (e) {\n  throw new Error('Output agen bukan JSON valid: ' + raw.slice(0, 200));\n}\n\nconst list = Array.isArray(data) ? data : (data.tweets || data.results || []);\n\nreturn list.map(t => ({\n  json: {\n    Timestamp: t.createdAt || t.created_at || new Date().toISOString(),\n    Tweet_ID: String(t.id),\n    Tweet_Text: t.text\n  }\n}));"
      },
