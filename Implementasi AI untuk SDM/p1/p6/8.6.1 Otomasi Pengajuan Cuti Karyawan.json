    {
      "parameters": {
        "jsCode": "// 1. Ambil Data Karyawan dari Input Node\nconst employeeData = items[0].json;\n\n// 2. Ambil Data Form (Sesuaikan nama node 'pengajuan cuti')\nconst formData = $('pengajuan cuti').first().json;\n\n// 3. Hitung Durasi Cuti (Luxon)\nconst start = DateTime.fromISO(formData[\"Tanggal Mulai\"]);\nconst end = DateTime.fromISO(formData[\"Tanggal Selesai\"]);\n\n// +1 agar inklusif (misal 7 Nov s/d 20 Nov = 14 hari)\nconst durationInDays = Math.round(end.diff(start, 'days').days) + 1;\n\n// 4. Ambil Saldo Cuti (PERBAIKAN: Gunakan \"Saldo Cuti\" / Fallback ke \"Saldo_Cuti\")\nconst rawBalance = employeeData[\"Saldo Cuti\"] ?? employeeData[\"Saldo_Cuti\"] ?? 0;\nconst currentBalance = parseInt(rawBalance, 10) || 0;\n\n// 5. Validasi Saldo (Boolean Murni)\nconst hasEnoughBalance = Boolean(currentBalance >= durationInDays);\n\n// Generate ID Unik\nconst uniqueId = 'REQ-' + Date.now(); \n\nreturn [\n  {\n    json: {\n      ...employeeData,\n      ...formData,\n      durationRequested: durationInDays,\n      isApprovedSystem: hasEnoughBalance, // Pastikan tipe boolean murni\n      message: hasEnoughBalance ? \"Saldo Cukup\" : \"Saldo Tidak Cukup\",\n      requestId: uniqueId\n    }\n  }\n];"
      },
